    <style>
        * {
            margin: 0;
            padding: 0;
            text-decoration: none;
        }

        a {
            color: rgb(15 10 145);
            display: block;
            padding: 0 0 0 10px;
        }

        #header {
            background: green;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 60px;
        }

        #header img {
            width: 50px;
            padding-left: 10px;
        }

        #main {
            box-sizing: border-box;
            flex-grow: 1;
            align-items: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            flex-wrap: wrap;
        }

        #footer img {
            width: 20px;
            padding: 5px;
        }

        #footer {
            background: yellow;
            justify-content: space-between;
            display: flex;
        }

        button,
        h2 {
            color: rgb(250 175 15);
            margin: 10px;
        }

        button {
            border: 3px solid black;
            display: inline-block;
            border-radius: 999px;
            padding: 5px;
            font-size: 15px;
            text-align: center;
        }

        a {
            display: flex;
            flex-direction: column;
            align-items: center;
            display: inline-block;
            padding: 10px;
        }

        #container {
            max-height: 300px;
            display: flex;
            flex-direction: column;
        }

        .card {
            display: flex;
            border: 5px solid black;
            border-radius: 5px;
            max-width: 100%;
            margin: 20px;
        }

        .card img {
            height: 200px;
            padding: 5px;
        }

        .vard {
            height: 200px;
        }

        p {
            margin: 10px;
            display: flex;
            align-items: center;
        }

        #footer {
            display: flex;
            align-items: center;
            height: 60px;
        }
    </style>

